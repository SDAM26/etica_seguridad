# =============================================================================
# Configuración del Password Manager
# =============================================================================
# Copia este archivo a .env y modifica los valores según tu entorno

# Secreto para firmar JWT (CAMBIAR EN PRODUCCIÓN)
# Genera uno con: openssl rand -hex 32
JWT_SECRET=dev_secret_please_change_in_production_asap

# Expiración del token JWT en minutos (default: 120 = 2 horas)
JWT_EXPIRE_MIN=120

# Puerto donde se expondrá la aplicación (default: 8080)
PORT=8080
